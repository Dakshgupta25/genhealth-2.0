# Hereditary Risk Engine — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# LLM (Gemini) — required for narrative generation layer
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Standalone server port (must differ from GenHealth backend on 8000)
HEREDITARY_RISK_PORT=8001

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Model artifacts directory (relative to module root or absolute)
MODELS_DIR=models

# Risk label thresholds (customizable without code changes)
RISK_THRESHOLD_LOW=0.33
RISK_THRESHOLD_HIGH=0.66
